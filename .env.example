# MathModel AI — Environment Configuration
# Copy this file to .env and fill in your values.

# Database
DATABASE_URL=postgresql://mathmodel:mathmodel@localhost:5432/mathmodel

# OpenAI
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-4o

# Google
GOOGLE_API_KEY=
GOOGLE_DEFAULT_MODEL=gemini-2.0-flash

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-20250514

# Model Routing
DEFAULT_PROVIDER=mock
MODEL_ROUTER_ENABLED=true

# Logging
LOG_LEVEL=INFO